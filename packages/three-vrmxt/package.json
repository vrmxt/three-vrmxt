{
  "name": "@vrmxt/three-vrmxt",
  "version": "0.1.0",
  "description": "Optional VRMXT / MToonXT GLTFLoader plugins beside @pixiv/three-vrm. Not a fork.",
  "type": "module",
  "license": "MIT",
  "author": "miramocha",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrmxt/three-vrmxt.git",
    "directory": "packages/three-vrmxt"
  },
  "homepage": "https://github.com/vrmxt/three-vrmxt#readme",
  "bugs": {
    "url": "https://github.com/vrmxt/three-vrmxt/issues"
  },
  "keywords": [
    "vrm",
    "vrmxt",
    "three",
    "gltf",
    "mtoon",
    "stencil"
  ],
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm run build"
  },
  "peerDependencies": {
    "@pixiv/three-vrm": "^3.4.0",
    "@pixiv/three-vrm-materials-mtoon": "^3.4.0",
    "three": ">=0.167.0"
  },
  "devDependencies": {
    "@pixiv/three-vrm": "^3.4.2",
    "@pixiv/three-vrm-materials-mtoon": "^3.4.2",
    "@types/three": "^0.185.4",
    "three": "^0.185.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
